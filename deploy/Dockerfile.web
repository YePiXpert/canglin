# 前端构建 + nginx 静态托管 / 反向代理
FROM node:22-alpine AS build
WORKDIR /repo
RUN corepack enable
COPY pnpm-workspace.yaml package.json ./
COPY pnpm-lock.yaml ./
COPY packages/shared/package.json packages/shared/
COPY apps/web/package.json apps/web/
RUN pnpm install --frozen-lockfile --filter @canglin/web... --filter @canglin/shared
COPY packages/shared packages/shared
COPY apps/web apps/web
RUN pnpm --filter @canglin/shared build && pnpm --filter @canglin/web build

FROM nginx:1.27-alpine
ARG SOURCE_REVISION=unknown
LABEL org.opencontainers.image.revision=$SOURCE_REVISION
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /repo/apps/web/dist /usr/share/nginx/html
EXPOSE 80
# 只检查静态页；API 由 server 自己的健康检查负责（nginx:alpine 自带 busybox wget）
HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
  CMD wget -qO- http://127.0.0.1/ >/dev/null || exit 1
