# API 服务端构建 + 运行
FROM node:22-alpine AS build
WORKDIR /repo
RUN corepack enable
COPY pnpm-workspace.yaml package.json ./
COPY pnpm-lock.yaml ./
COPY packages/shared/package.json packages/shared/
COPY apps/server/package.json apps/server/
RUN pnpm install --frozen-lockfile --filter @procure-lite/server... --filter @procure-lite/shared
COPY packages/shared packages/shared
COPY apps/server apps/server
RUN pnpm --filter @procure-lite/shared build \
  && cd apps/server && npx prisma generate \
  && pnpm --filter @procure-lite/server build

FROM node:22-alpine
# 时区数据：让 TZ（如 Asia/Shanghai）对 libc 和 Node 都生效；放在 ARG 之前，不随版本号失效缓存
RUN apk add --no-cache tzdata
ARG SOURCE_REVISION=unknown
LABEL org.opencontainers.image.revision=$SOURCE_REVISION
WORKDIR /app
ENV NODE_ENV=production
COPY --from=build /repo/node_modules ./node_modules
COPY --from=build /repo/packages/shared/package.json ./packages/shared/
COPY --from=build /repo/packages/shared/dist ./packages/shared/dist
COPY --from=build /repo/packages/shared/node_modules ./packages/shared/node_modules
COPY --from=build /repo/apps/server/package.json ./apps/server/
COPY --from=build /repo/apps/server/dist ./apps/server/dist
COPY --from=build /repo/apps/server/prisma ./apps/server/prisma
COPY --from=build /repo/apps/server/node_modules ./apps/server/node_modules
COPY deploy/entrypoint-server.sh /entrypoint.sh
WORKDIR /app/apps/server
EXPOSE 3000
# 入口逻辑在 entrypoint-server.sh（CMD 内联 shell 的 JSON 转义易踩坑，已弃用）
ENTRYPOINT ["sh", "/entrypoint.sh"]
