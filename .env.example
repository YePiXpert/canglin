# 复制为 .env（或 compose 环境变量）后按需修改
# API 服务端口
PORT=3000
# 受控反代层数：直接访问应用 nginx 为 1；外层反代 → nginx → API 为 2；外层反代前还有 Cloudflare 时为 3；API 直连为 0。
# 使用 2 或 3 时 WEB_PORT 应绑定 127.0.0.1:8080，禁止绕过外层反代。
TRUST_PROXY_HOPS=1
# 可信代理地址。Compose 默认 Docker 网桥范围；部署时按 docker network inspect 缩小。
# 用 3 层时追加 Cloudflare 公布的地址段（https://www.cloudflare.com/ips/），否则记下的是 Cloudflare 节点地址。
# 非 Compose 运行默认仅信任 loopback。不要填客户端地址或 0.0.0.0/0。
# TRUST_PROXY_CIDRS=172.22.0.0/16
# 数据目录（数据库 / 上传 / 备份 / 密钥）
DATA_DIR=./state
# Prisma 数据库连接（与 DATA_DIR 指向同一文件）
DATABASE_URL=file:./state/canglin.db
# OCR 微服务地址与内部通信密钥
OCR_BASE_URL=http://127.0.0.1:8000
OCR_API_KEY=dev-ocr-key
# 上传大小限制（MB）
MAX_UPLOAD_MB=30
# 服务器时区：每日 3 点的维护任务和本地日期按它计算（compose 未设置时默认 Asia/Shanghai）
TZ=Asia/Shanghai
# AI 使用 Responses API；第三方需完成图像和严格结构化输出能力测试
# LLM_BASE_URL=https://your-provider.example/v1
# LLM_API_KEY=
# LLM_API_KEY_FILE=/run/secrets/llm_api_key
# LLM_MODEL=gpt-6.1-sol
# 设置页可选的模型（逗号分隔）；未设置为下面三个，* 表示不限制
# LLM_ALLOWED_MODELS=gemini-3.8-flash-high,gpt-6.1-sol,grok-4.7
# 三个镜像使用同一个源码标签；deploy.sh / upgrade.sh 会持久化绑定 sha 标签
# RELEASE_TAG=sha-abcdef0
