# 复制为 .env（或 compose 环境变量）后按需修改
# API 服务端口
PORT=3000
# 数据目录（数据库 / 上传 / 备份 / 密钥）
DATA_DIR=./state
# Prisma 数据库连接（与 DATA_DIR 指向同一文件）
DATABASE_URL=file:./state/canglin.db
# OCR 微服务地址与内部通信密钥
OCR_BASE_URL=http://127.0.0.1:8000
OCR_API_KEY=dev-ocr-key
# 上传大小限制（MB）
MAX_UPLOAD_MB=30
# 服务器时区：每日 3 点的维护任务和本地日期按它计算（compose 未设置时默认 Asia/Shanghai）
TZ=Asia/Shanghai
# AI 使用 Responses API；第三方需完成图像和严格结构化输出能力测试
# LLM_BASE_URL=https://your-provider.example/v1
# LLM_API_KEY=
# LLM_API_KEY_FILE=/run/secrets/llm_api_key
# LLM_MODEL=gpt-6-sol
# 三个镜像使用同一个源码标签；deploy.sh / upgrade.sh 会持久化绑定 sha 标签
# RELEASE_TAG=sha-abcdef0
