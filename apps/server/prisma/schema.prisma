generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  action     String
  entity     String?
  entityId   Int?
  detail     String? // JSON
  operatorIp String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([entity, entityId])
}

model Supplier {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  contact   String?
  phone     String?
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  businessDocuments BusinessDocument[]
}

/* 附件：申请原件（OA_DOC）、采购发票、发放签收凭证 */
model Attachment {
  id            Int          @id @default(autoincrement())
  kind          String // OA_DOC | INVOICE | SIGNOFF
  procurementRequestId Int?
  procurementRequest ProcurementRequest? @relation(fields: [procurementRequestId], references: [id], onDelete: Restrict)
  businessDocumentId Int?
  businessDocument BusinessDocument? @relation(fields: [businessDocumentId], references: [id], onDelete: Restrict)
  filename      String
  storagePath   String
  mimeType      String
  sizeBytes     Int
  createdAt     DateTime     @default(now())

  @@index([procurementRequestId])
  @@index([businessDocumentId])
}

/* OA 导入任务（持久化，重启不丢） */
model ImportTask {
  id          String    @id
  filename    String
  status      String // PENDING | RUNNING | DONE | FAILED
  result      String? // JSON ParseResult
  error       String?
  /** 原件相对 uploads 的路径；确认导入后转为申请原件附件，未确认的由定期清理回收 */
  storagePath String?
  createdAt   DateTime  @default(now())
  finishedAt  DateTime?
  contentHash String?
  draft       String?
  version     Int      @default(0)
  generation  Int      @default(0)
  aiStatus    String   @default("DISABLED")
  aiResult    String?
  confirmedAt DateTime?
  confirmation String?
  procurementRequest ProcurementRequest?
  @@index([contentHash])
}

/* 单管理员安全状态 */
model SystemSecurity {
  id               Int       @id @default(1)
  passwordHash     String
  recoveryCodeHash String?
  failedAttempts   Int       @default(0)
  lockedUntil      DateTime?
  sessionEpoch     Int       @default(0)
  updatedAt        DateTime  @updatedAt
}

model Setting {
  key   String @id
  value String
}


model OperationReceipt {
  id String @id
  scope String
  requestHash String
  response String
  createdAt DateTime @default(now())
  @@index([createdAt])
}

model ImportRevision {
  id Int @id @default(autoincrement())
  taskId String
  kind String // DRAFT | LOCAL
  version Int
  snapshot String
  createdAt DateTime @default(now())
  @@unique([taskId, kind, version])
}

model AiCall {
  id String @id
  taskId String?
  page Int?
  generation Int @default(0)
  model String
  status String
  response String?
  inputTokens Int?
  outputTokens Int?
  cost Float?
  requestId String?
  durationMs Int?
  // RECOGNITION | REVIEW 与提示词版本（apps/server/src/ai/prompts.ts），评测按版本归因
  promptVersion String?
  mode String?
  createdAt DateTime @default(now())
  @@index([taskId, createdAt])
}

// V3 workflow. CHECK constraints on enum-like columns live in the migrations (Prisma cannot model them).
// Scaled integers: quantities 6 decimals, unit prices 4, line amounts CNY fen.
model CatalogProduct {
  id Int @id @default(autoincrement())
  name String
  specification String @default("")
  unit String
  createdAt DateTime @default(now())
  requestLines ProcurementLine[]
  businessLines BusinessLine[]
  balances StockBalance[]
  entries StockEntry[]
  @@unique([name, specification, unit])
}

model ProcurementRequest {
  id Int @id @default(autoincrement())
  serialNumber String
  department String
  handler String
  requestDate String
  note String?
  sourceTaskId String? @unique
  sourceTask ImportTask? @relation(fields: [sourceTaskId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())
  lines ProcurementLine[]
  attachments Attachment[]
  @@index([requestDate])
  @@index([serialNumber])
}

model ProcurementLine {
  id Int @id @default(autoincrement())
  requestId Int
  request ProcurementRequest @relation(fields: [requestId], references: [id], onDelete: Restrict)
  lineNumber Int
  productId Int
  product CatalogProduct @relation(fields: [productId], references: [id], onDelete: Restrict)
  itemName String
  specification String @default("")
  unit String
  quantityUnits BigInt
  cancelledUnits BigInt @default(0)
  orderedUnits BigInt @default(0)
  note String?
  businessLines BusinessLine[]
  @@unique([requestId, lineNumber])
  @@index([productId])
}

model BusinessDocument {
  id Int @id @default(autoincrement())
  kind String // WORKFLOW_DOCUMENT_KINDS
  date String
  status String @default("POSTED") // POSTED | VOIDED
  supplierId Int?
  supplier Supplier? @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  supplierName String?
  department String?
  source String?
  returnMode String?
  note String?
  totalAmountUnits BigInt?
  paymentStatus String @default("UNPAID") // PAYMENT_STATUSES
  invoiceIssued Boolean @default(false)
  voidReason String?
  voidDate String?
  voidedAt DateTime?
  createdAt DateTime @default(now())
  lines BusinessLine[]
  attachments Attachment[]
  @@index([kind, status, date])
  @@index([supplierId])
}

model BusinessLine {
  id Int @id @default(autoincrement())
  documentId Int
  document BusinessDocument @relation(fields: [documentId], references: [id], onDelete: Restrict)
  requestLineId Int?
  requestLine ProcurementLine? @relation(fields: [requestLineId], references: [id], onDelete: Restrict)
  sourceLineId Int?
  sourceLine BusinessLine? @relation("BusinessLineSource", fields: [sourceLineId], references: [id], onDelete: Restrict)
  derivedLines BusinessLine[] @relation("BusinessLineSource")
  productId Int
  product CatalogProduct @relation(fields: [productId], references: [id], onDelete: Restrict)
  itemName String
  specification String @default("")
  unit String
  quantityUnits BigInt
  unitPriceUnits BigInt?
  amountUnits BigInt?
  purchaseReductionAmountUnits BigInt?
  receivedUnits BigInt @default(0)
  cancelledUnits BigInt @default(0)
  purchaseLink String?
  recipient String?
  location String?
  reason String?
  balances StockBalance[] @relation("BalanceOrigin")
  originEntries StockEntry[] @relation("EntryOrigin")
  entries StockEntry[] @relation("EntryBusinessLine")
  @@index([requestLineId])
  @@index([sourceLineId])
  @@index([documentId])
}

model StockBalance {
  id Int @id @default(autoincrement())
  productId Int
  product CatalogProduct @relation(fields: [productId], references: [id], onDelete: Restrict)
  originLineId Int
  originLine BusinessLine @relation("BalanceOrigin", fields: [originLineId], references: [id], onDelete: Restrict)
  location String
  quantityUnits BigInt @default(0)
  @@unique([productId, originLineId, location])
  @@index([productId, location])
}

model StockEntry {
  id Int @id @default(autoincrement())
  productId Int
  product CatalogProduct @relation(fields: [productId], references: [id], onDelete: Restrict)
  businessLineId Int
  businessLine BusinessLine @relation("EntryBusinessLine", fields: [businessLineId], references: [id], onDelete: Restrict)
  originLineId Int
  originLine BusinessLine @relation("EntryOrigin", fields: [originLineId], references: [id], onDelete: Restrict)
  location String
  quantityUnits BigInt
  date String
  reversalOfId Int? @unique
  reversalOf StockEntry? @relation("StockEntryReversal", fields: [reversalOfId], references: [id], onDelete: Restrict)
  reversal StockEntry? @relation("StockEntryReversal")
  createdAt DateTime @default(now())
  @@index([productId, date])
  @@index([originLineId, location])
  @@index([businessLineId])
}
